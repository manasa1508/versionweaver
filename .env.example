VERSIONWEAVER_ENVIRONMENT=development
VERSIONWEAVER_DATABASE_URL=sqlite:///./versionweaver.sqlite3
VERSIONWEAVER_ARTIFACT_BACKEND=local
VERSIONWEAVER_ARTIFACT_DIR=./artifacts
VERSIONWEAVER_API_TOKEN=change-me-before-hosting
# Production requires distinct admin and runner tokens. Development falls back to API_TOKEN.
VERSIONWEAVER_ADMIN_API_TOKEN=
VERSIONWEAVER_RUNNER_API_TOKEN=
VERSIONWEAVER_PUBLIC_BASE_URL=http://localhost:8000
VERSIONWEAVER_LOG_LEVEL=INFO

# Optional S3-compatible storage (MinIO, Cloudflare R2, AWS S3, Backblaze B2)
VERSIONWEAVER_S3_ENDPOINT_URL=http://minio:9000
VERSIONWEAVER_S3_BUCKET=versionweaver-evidence
VERSIONWEAVER_S3_REGION=us-east-1
VERSIONWEAVER_S3_ACCESS_KEY_ID=versionweaver
VERSIONWEAVER_S3_SECRET_ACCESS_KEY=versionweaver-dev-secret

# Runner settings
VERSIONWEAVER_RUNNER_ID=local-runner
VERSIONWEAVER_SERVER_URL=http://localhost:8000
VERSIONWEAVER_RUNNER_POLL_SECONDS=5
VERSIONWEAVER_SANDBOX_ENGINE=docker
VERSIONWEAVER_SANDBOX_IMAGE=python:3.12-slim
VERSIONWEAVER_ALLOW_UNSAFE_LOCAL_EXECUTION=false

# Optional OpenAI-compatible endpoint; Ollama works without an API key.
VERSIONWEAVER_MODEL_BASE_URL=http://host.docker.internal:11434/v1
VERSIONWEAVER_MODEL_API_KEY=
